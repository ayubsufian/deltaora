FROM node:22-alpine AS builder

LABEL org.opencontainers.image.source="https://github.com/ayubsufian/deltaora"
LABEL org.opencontainers.image.description="Deltaora Backend API Server"

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/ packages/
COPY apps/server/ apps/server/

RUN pnpm install --filter=@deltaora/server...
RUN pnpm --filter=@deltaora/server build

# Production image with Playwright dependencies
FROM mcr.microsoft.com/playwright:v1.44.1-jammy

WORKDIR /app
# Copy Node.js from builder stage (avoids deprecated NodeSource script)
COPY --from=builder /usr/local/bin/node /usr/local/bin/node
COPY --from=builder /usr/local/bin/corepack /usr/local/bin/corepack
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Copy workspace
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/apps/server/package.json /app/apps/server/
COPY --from=builder /app/apps/server/dist /app/apps/server/dist

RUN pnpm install --prod --filter=@deltaora/server...

EXPOSE 5000
CMD ["node", "apps/server/dist/index.js"]
