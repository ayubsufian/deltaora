FROM node:22-alpine AS builder

LABEL org.opencontainers.image.source="https://github.com/ayubsufian/deltaora"
LABEL org.opencontainers.image.description="Deltaora Frontend Client"

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

# Copy root config files
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./

# Copy package sources
COPY packages/ packages/
COPY apps/client/ apps/client/

# Install dependencies and build
RUN pnpm install --filter=@deltaora/client...
RUN pnpm --filter=@deltaora/client build

FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/apps/client/dist /usr/share/nginx/html
# Copy default nginx config for SPA
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
