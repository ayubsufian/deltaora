# Copy to production.env on the production host and replace every placeholder.
# Use immutable image references with digests for reproducible deploys.
DELTAORA_FRONTEND_IMAGE=ghcr.io/ayubsufian/deltaora-frontend@sha256:replace-with-frontend-digest
DELTAORA_BACKEND_IMAGE=ghcr.io/ayubsufian/deltaora-backend@sha256:replace-with-backend-digest
MONGO_IMAGE=mongo:7.0@sha256:replace-with-mongo-digest
REDIS_IMAGE=redis:7-alpine@sha256:replace-with-redis-digest
NGINX_IMAGE=nginx:alpine@sha256:replace-with-nginx-digest

CLIENT_URL=https://deltaora.example
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
WEBAUTHN_RP_ID=deltaora.example
WEBAUTHN_ORIGIN=https://deltaora.example
MONGO_ROOT_USERNAME=deltaora

# Secret source files are read by Docker Compose and mounted under /run/secrets.
MONGO_ROOT_PASSWORD_SOURCE=/etc/deltaora/secrets/mongo_root_password
REDIS_PASSWORD_SOURCE=/etc/deltaora/secrets/redis_password
JWT_SECRET_SOURCE=/etc/deltaora/secrets/jwt_secret
JWT_REFRESH_SECRET_SOURCE=/etc/deltaora/secrets/jwt_refresh_secret
CSRF_SECRET_SOURCE=/etc/deltaora/secrets/csrf_secret
MFA_SECRET_ENCRYPTION_KEY_SOURCE=/etc/deltaora/secrets/mfa_secret_encryption_key
GEMINI_API_KEY_SOURCE=/etc/deltaora/secrets/gemini_api_key
BREVO_API_KEY_SOURCE=/etc/deltaora/secrets/brevo_api_key

PASSWORD_BREACH_SCREENING_MODE=api
PASSWORD_BREACH_SCREENING_TIMEOUT_MS=3000
PASSWORD_BREACH_SCREENING_CACHE_TTL_SECONDS=86400
PASSWORD_BREACH_SCREENING_CACHE_MAX_PREFIXES=4096
PASSWORD_BREACH_SCREENING_LOCAL_DIR=
PWNED_PASSWORDS_RANGE_URL=https://api.pwnedpasswords.com/range
PWNED_PASSWORDS_USER_AGENT=Deltaora password breach screening

CRAWLER_USER_AGENT=DeltaoraBot/1.0 (+https://deltaora.example/crawler)
CRAWLER_CONTACT_URL=https://deltaora.example/crawler
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_ALLOW_PRIVATE_NETWORKS=false
CRAWLER_PRIVATE_NETWORK_ALLOWLIST=
CRAWLER_ROBOTS_UNAVAILABLE_POLICY=fail_closed
CRAWLER_MAX_BYTES=10000000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MIN_HOST_DELAY_MS=5000
CRAWLER_ROBOTS_CACHE_SECONDS=3600
CRAWLER_ROBOTS_MAX_BYTES=512000

EMAIL_FROM=noreply@deltaora.example
PROXY_URL=
