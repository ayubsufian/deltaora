NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:5173

# Database & Caching
MONGODB_URI=mongodb://localhost:27017/deltaora
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=change-me-to-a-random-64-byte-url-safe-secret-for-access-tokens
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-byte-url-safe-secret-for-refresh-tokens
CSRF_SECRET=change-me-to-a-different-random-64-byte-url-safe-secret-for-csrf
MFA_SECRET_ENCRYPTION_KEY=change-me-to-a-random-32-byte-or-longer-secret-for-mfa-encryption
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
PASSWORD_BREACH_SCREENING_MODE=api
PASSWORD_BREACH_SCREENING_FAILURE_POLICY=block
PASSWORD_BREACH_SCREENING_TIMEOUT_MS=3000
PASSWORD_BREACH_SCREENING_CACHE_TTL_SECONDS=86400
PASSWORD_BREACH_SCREENING_CACHE_MAX_PREFIXES=4096
# Use with PASSWORD_BREACH_SCREENING_MODE=local. Files are named by 5-char SHA-1 prefix, e.g. ABCDE.txt.
PASSWORD_BREACH_SCREENING_LOCAL_DIR=
PWNED_PASSWORDS_RANGE_URL=https://api.pwnedpasswords.com/range
PWNED_PASSWORDS_USER_AGENT=Deltaora password breach screening

# AI / Scraping
GEMINI_API_KEY=your_gemini_api_key_here
PROXY_URL=
CRAWLER_USER_AGENT=DeltaoraBot/1.0 (+https://example.com/crawler)
CRAWLER_CONTACT_URL=https://example.com/crawler
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_ALLOW_PRIVATE_NETWORKS=false
CRAWLER_PRIVATE_NETWORK_ALLOWLIST=
CRAWLER_ROBOTS_UNAVAILABLE_POLICY=fail_closed
CRAWLER_MAX_BYTES=10000000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MIN_HOST_DELAY_MS=5000
CRAWLER_ROBOTS_CACHE_SECONDS=3600
CRAWLER_ROBOTS_MAX_BYTES=512000

# Email Infrastructure (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=noreply@deltaora.com
