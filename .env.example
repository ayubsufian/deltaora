NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:5173

# Database & Caching
MONGODB_URI=mongodb://localhost:27017/deltaora
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=change-me-to-a-random-64-byte-url-safe-secret-for-access-tokens
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-byte-url-safe-secret-for-refresh-tokens
CSRF_SECRET=change-me-to-a-different-random-64-byte-url-safe-secret-for-csrf
MFA_SECRET_ENCRYPTION_KEY=change-me-to-a-random-32-byte-or-longer-secret-for-mfa-encryption
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# AI / Scraping
GEMINI_API_KEY=your_gemini_api_key_here
PROXY_URL=

# Email Infrastructure (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=noreply@deltaora.com
